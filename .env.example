SECRET_KEY=replace-with-a-long-random-secret
DATABASE_MODE=sqlite
SQLITE_PATH=instance/diet_planner.db

STORAGE_MODE=local
UPLOAD_FOLDER=storage
MAX_CONTENT_LENGTH_MB=5

